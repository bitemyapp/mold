+#!/usr/bin/env bash
+. $(dirname $0)/common.inc
+
+# Each ordinary output section has one small relocated member. This exercises
+# batching across output-section boundaries instead of within one section.
+{
+  echo '.globl _start'
+  echo '_start: .byte 0'
+  awk 'BEGIN { for (i = 0; i < 5000; i++) {
+    printf ".section .data.case%d,\"aw\",@progbits\n.quad value\n", i
+  }}'
+} | $CC -c -xassembler -o $t/a.o -
+
+echo '.data; .globl value; value: .quad 42' | $CC -c -xassembler -o $t/b.o -
+./mold --unique --threads=1 --build-id=sha256 -o $t/serial $t/a.o $t/b.o
+./mold --unique --threads=8 --build-id=sha256 -o $t/parallel $t/a.o $t/b.o
+cmp $t/serial $t/parallel
