index 0000000000000000000000000000000000000000..e2cea4c183baba553ea5f26f6e2c8d5f4271fe8f
--- /dev/null
+++ b/tests/arch-x86_64-debug-fragment-offsets.sh
@@ -0,0 +1,45 @@
+#!/usr/bin/env bash
+. $(dirname $0)/common.inc
+
+# This pool crosses the translation threshold. Check both section-symbol
+# addends and named-symbol addends against the bytes of the merged pool.
+{
+  cat <<'ASM'
+.globl _start, first
+_start: ret
+.section .debug_str,"MS",@progbits,1
+first:
+ASM
+  awk 'BEGIN { for (i = 0; i < 8192; i++) { printf ".Lstr%d: .asciz \"unique-%05d\"\n", i, i } }'
+  cat <<'ASM'
+.section .debug_probe,"",@progbits
+.quad first + 3
+.quad .Lstr8191 + 2
+.quad first - 1
+.quad .Lstr17 + 1
+.quad 1234
+ASM
+} | $CC -c -o $t/a.o -xassembler -
+
+# Duplicate input strings exercise the many-to-one translation.
+{
+  printf '.section .debug_str,"MS",@progbits,1\n'
+  awk 'BEGIN { for (i = 4095; i >= 0; i--) printf ".asciz \"unique-%05d\"\n", i }'
+} | $CC -c -o $t/b.o -xassembler -
+
+./mold -o $t/exe $t/a.o $t/b.o --stats > $t/log
+awk -F= '/translated_debug_fragments/ { if ($2 >= 12288) found = 1 } END { exit !found }' $t/log
+$OBJCOPY --dump-section .debug_probe=$t/probe --dump-section .debug_str=$t/strings $t/exe
+read first last negative middle absolute <<< "$(od -An -tu8 -v $t/probe | xargs)"
+[ "$negative" = "$((first - 4))" ]
+[ "$absolute" = 1234 ]
+[ "$(dd if=$t/strings bs=1 skip=$((first - 3)) count=12 2>/dev/null)" = unique-00000 ]
+[ "$(dd if=$t/strings bs=1 skip=$((last - 2)) count=12 2>/dev/null)" = unique-08191 ]
+[ "$(dd if=$t/strings bs=1 skip=$((middle - 1)) count=12 2>/dev/null)" = unique-00017 ]
+
+# Compression must consume the same final offsets before freeing input data.
+./mold -o $t/compressed $t/a.o $t/b.o --compress-debug-sections=zlib
+$OBJCOPY --decompress-debug-sections $t/compressed $t/uncompressed
+$OBJCOPY --dump-section .debug_probe=$t/probe2 --dump-section .debug_str=$t/strings2 $t/uncompressed
+cmp $t/probe $t/probe2
+cmp $t/strings $t/strings2
