+/// Copies final debug-string offsets into each input's sequential fragment
+/// table. Run after DWARF32 ordering and before debug compression relocates it.
+pub fn prepare_nonalloc_fragment_offsets<E: Target>(ctx: &mut Context<E>) {
+    let _t = ctx.timer("prepare_fragment_offsets");
+    static TRANSLATED: Counter = Counter::new("translated_debug_fragments");
+    let Context { objs, merged_sections, .. } = ctx;
+    objs.par_iter_mut().for_each(|file| {
+        for (info, _) in file.sections.merge_infos_with_inputs_mut() {
+            let parent = &merged_sections[info.parent.index()];
+            if !parent.is_alloc()
+                && parent.hdr.name.starts_with(b".debug_")
+                && parent.hdr.shdr.sh_flags.get() & SHF_STRINGS as u64 != 0
+                && parent.estimation >= 4096
+                && info.fragments.len() >= 32
+            {
+                info.prepare_final_offsets(parent);
+                TRANSLATED.add(info.fragments.len() as i64);
+            }
+        }
+    });
+}
