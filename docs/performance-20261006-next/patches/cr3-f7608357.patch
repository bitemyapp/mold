+    /// Prefetches the actual target of a future nonallocated relocation.
+    /// This performs no symbol resolution, diagnostics, or state mutation.
+    #[inline]
+    pub(crate) fn prefetch_target<E: Target>(&self, ctx: &Context<E>, offset: u64) {
+        if let Some(idx) = self.frag_offsets.partition_point(|&o| o as u64 <= offset).checked_sub(1)
+            && let Some(&entry) = self.fragments.get(idx)
+        {
+            ctx.merged_sections[self.parent.index()].fragments.prefetch(entry);
+        }
+    }
+
     /// Finds the fragment containing `offset` and the offset within it.
     #[inline]
     pub fn fragment(&self, offset: u64) -> Option<(EntryId, i64)> {
diff --git a/tests/arch-x86_64-nonalloc-window.sh b/tests/arch-x86_64-nonalloc-window.sh
new file mode 100755
index 0000000000000000000000000000000000000000..fabbdff5a873a2949ac8ff6c4da4b52c28644d23
--- /dev/null
+++ b/tests/arch-x86_64-nonalloc-window.sh
@@ -0,0 +1,49 @@
+#!/usr/bin/env bash
+. $(dirname $0)/common.inc
+
+[ $MACHINE = x86_64 ] || skip
+
+# A lookahead window must preserve relocation order, including overlapping
+# writes and a later block overwriting an earlier block's result.
+cat <<'ASM' | $CC -c -o $t/a.o -xassembler -
+.globl _start
+_start:
+  ret
+.section .debug_a,"",@progbits
+a: .byte 0
+.section .nonalloc,"",@progbits
+.quad 0
+.reloc 0, R_X86_64_64, a + 42
+.reloc 0, R_X86_64_32, a + 7
+.rept 128
+.quad a + 11
+.endr
+.reloc 0, R_X86_64_64, a + 99
+ASM
+
+./mold -o $t/exe $t/a.o
+$OBJCOPY --dump-section .nonalloc=$t/data $t/exe
+od -An -tu8 -v $t/data | xargs > $t/words
+{
+  printf '99'
+  for i in $(seq 1 128); do printf ' 11'; done
+  printf '\n'
+} | cmp - $t/words
+
+# Range diagnostics retain their original relocation order.
+cat <<'ASM' | $CC -c -o $t/b.o -xassembler -
+.globl _start
+_start:
+  ret
+.section .nonalloc,"",@progbits
+.byte limit
+.short limit
+.long limit
+.long 0
+.reloc 7, R_X86_64_32S, limit
+ASM
+
+not ./mold -o $t/bad --defsym=limit=4294967296 $t/b.o > $t/log 2>&1
+for ty in R_X86_64_8 R_X86_64_16 R_X86_64_32 R_X86_64_32S; do
+  grep "relocation $ty against limit out of range" $t/log
+done
