 use rayon::prelude::*;
 
+/// Experimental phase budget. Only the selected phase enters a separate
+/// bounded Rayon pool; other passes keep the linker's normal worker count.
+/// Callers enter at phase boundaries, without holding worker-local locks.
+/// Pool creation is intentionally part of measured link work.
+pub(crate) fn with_phase_budget<R: Send>(
+    phase: &str,
+    timers: &crate::util::perf::Timers,
+    run: impl FnOnce() -> R + Send,
+) -> R {
+    use std::sync::OnceLock;
+
+    struct Budget {
+        phase: String,
+        threads: usize,
+        pool: OnceLock<rayon::ThreadPool>,
+    }
+    static BUDGET: OnceLock<Option<Budget>> = OnceLock::new();
+    let budget = BUDGET.get_or_init(|| {
+        std::env::var("MOLD_PHASE_BUDGET").ok().map(|value| {
+            let Some((phase, count)) = value.split_once(':') else {
+                crate::fatal!("MOLD_PHASE_BUDGET must be merge:N, copy:N, or gc:N");
+            };
+            let threads = count.parse::<usize>().unwrap_or(0);
+            if !matches!(phase, "merge" | "copy" | "gc") || threads == 0 {
+                crate::fatal!("MOLD_PHASE_BUDGET must be merge:N, copy:N, or gc:N with N > 0");
+            }
+            Budget { phase: phase.to_owned(), threads, pool: OnceLock::new() }
+        })
+    });
+    let Some(budget) = budget else { return run() };
+    if budget.phase != phase || budget.threads >= rayon::current_num_threads() {
+        return run();
+    }
+    let pool = budget.pool.get_or_init(|| {
+        let _t = timers.start("phase_pool_init");
+        rayon::ThreadPoolBuilder::new()
+            .num_threads(budget.threads)
+            .thread_name(|i| format!("mold-phase-{i}"))
+            .build()
+            .unwrap_or_else(|err| crate::fatal!("failed to build phase thread pool: {err}"))
+    });
+    pool.install(run)
+}
+
