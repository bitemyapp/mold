diff --git a/tests/phase-thread-budget.sh b/tests/phase-thread-budget.sh
new file mode 100755
index 0000000000000000000000000000000000000000..ec7e93a1f7e2dc95f20fe0a6ede68c17991572d4
--- /dev/null
+++ b/tests/phase-thread-budget.sh
@@ -0,0 +1,19 @@
+#!/usr/bin/env bash
+. $(dirname $0)/common.inc
+unset MOLD_PHASE_BUDGET
+
+cat <<'EOF' | $CC -c -g -ffunction-sections -fdata-sections -x c -o $t/a.o -
+#include <stdio.h>
+static const char message[] = "phase budgets preserve linker output";
+int main(void) { puts(message); return 0; }
+EOF
+
+$CC -B. -Wl,--threads=8,--gc-sections,--build-id=sha256 -o $t/baseline $t/a.o
+for phase in merge copy gc; do
+  for threads in 1 2 4; do
+    MOLD_PHASE_BUDGET=$phase:$threads $CC -B. \
+      -Wl,--threads=8,--gc-sections,--build-id=sha256 -o $t/limited $t/a.o
+    cmp $t/baseline $t/limited
+  done
+done
+$QEMU $t/limited | grep 'phase budgets preserve linker output'
