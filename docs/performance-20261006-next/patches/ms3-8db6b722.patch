diff --git a/tests/arch-x86_64-mergeable-string-density.sh b/tests/arch-x86_64-mergeable-string-density.sh
new file mode 100755
index 0000000000000000000000000000000000000000..54dadf644f8f56736ca1f627fba0bc8f5e66243a
--- /dev/null
+++ b/tests/arch-x86_64-mergeable-string-density.sh
@@ -0,0 +1,59 @@
+#!/usr/bin/env bash
+. $(dirname $0)/common.inc
+
+# Two opposite density changes exercise storage growth while references to
+# every string must continue to resolve correctly. Wide strings exercise
+# the same path with a terminator wider than one byte.
+awk 'BEGIN {
+  for (group = 0; group < 2; group++) {
+    printf ".section .rodata.density%d,\"aMS\",@progbits,1\n", group
+    for (i = 0; i < 2048; i++) {
+      printf "s%d_%d: .string \"%d:%04d", group, i, group, i
+      if ((i < 64) == (group == 0))
+        for (j = 0; j < 200; j++) printf "x"
+      print "\""
+    }
+  }
+  print ".section .rodata.wide,\"aMS\",@progbits,4"
+  print ".p2align 2"
+  for (i = 0; i < 2048; i++) printf "w%d: .long %d, 0\n", i, i + 1
+  print ".section .data,\"aw\",@progbits"
+  print ".globl strings"
+  print "strings:"
+  for (group = 0; group < 2; group++)
+    for (i = 0; i < 2048; i++) printf ".quad s%d_%d\n", group, i
+  print ".globl wide_strings"
+  print "wide_strings:"
+  for (i = 0; i < 2048; i++) printf ".quad w%d\n", i
+  print ".section .note.GNU-stack,\"\",@progbits"
+}' > $t/a.s
+$CC -c -o $t/a.o $t/a.s
+
+cat <<'EOF' | $CC -c -o $t/b.o -x c -
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+extern const char *strings[2][2048];
+extern const uint32_t *wide_strings[2048];
+int main() {
+  for (int group = 0; group < 2; group++) {
+    for (int i = 0; i < 2048; i++) {
+      char expected[256];
+      int n = sprintf(expected, "%d:%04d", group, i);
+      if ((i < 64) == (group == 0)) {
+        memset(expected + n, 'x', 200);
+        n += 200;
+      }
+      expected[n] = 0;
+      assert(strcmp(strings[group][i], expected) == 0);
+      assert(wide_strings[i][0] == i + 1 && wide_strings[i][1] == 0);
+    }
+  }
+}
+EOF
+for threads in 1 8; do
+  $CC -B. -o $t/exe$threads $t/a.o $t/b.o -Wl,--threads=$threads
+  $QEMU $t/exe$threads
+done
+cmp $t/exe1 $t/exe8
