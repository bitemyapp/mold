+/// Runs both member passes with identical ownership. The only redistributed
+/// values are at most one contiguous member range per section and worker;
+/// fragment bytes, hashes, and offsets stay in their original allocations.
+fn resolve_with_local_ownership<E: Target>(
+    sections: &mut [MergedSection<E>],
+    members: &mut [Vec<ResolveMember<'_>>],
+    allocated_only: bool,
+    gc_sections: bool,
+    timers: &Timers,
+) {
+    use std::sync::Mutex;
+    let t = timers.start("assign_merge_workers");
+    let workers = rayon::current_num_threads();
+    let mut jobs: Vec<Vec<(usize, &mut [ResolveMember<'_>])>> =
+        (0..workers).map(|_| Vec::new()).collect();
+    let mut estimates: Vec<Option<HyperLogLog>> = sections
+        .iter()
+        .map(|section| {
+            (!section.resolved && (!allocated_only || section.is_alloc()))
+                .then(HyperLogLog::default)
+        })
+        .collect();
+    for (id, members) in members.iter_mut().enumerate() {
+        if estimates[id].is_none() {
+            continue;
+        }
+        let mut bytes: usize = members.iter().map(|member| member.data.len()).sum();
+        let mut remaining = members.as_mut_slice();
+        for (worker, jobs) in jobs.iter_mut().enumerate() {
+            if remaining.is_empty() {
+                break;
+            }
+            let target =
+                if worker + 1 == workers { usize::MAX } else { bytes.div_ceil(workers - worker) };
+            let mut end = 0;
+            let mut size = 0;
+            while end < remaining.len() && (end == 0 || size < target) {
+                size += remaining[end].data.len();
+                end += 1;
+            }
+            let part = remaining.split_off_mut(..end).unwrap();
+            jobs.push((id, part));
+            bytes -= size;
+        }
+        debug_assert!(remaining.is_empty());
+    }
+    // Each mutex is acquired only by its matching broadcast worker. There is
+    // no nested Rayon work or worker-local guard while a job slot is held.
+    let jobs: Vec<_> = jobs.into_iter().map(Mutex::new).collect();
+    drop(t);
+
+    let t = timers.start("split_contents");
+    let parts = rayon::broadcast(|worker| {
+        let mut jobs = jobs[worker.index()].lock().unwrap();
+        jobs.iter_mut()
+            .map(|(id, members)| {
+                let mut sketch = HyperLogLog::default();
+                for member in members.iter_mut() {
+                    member.merge_info.split_contents::<E>(
+                        &display_file(member.filename, member.archive_name),
+                        member.data,
+                        member.name,
+                        &sections[*id],
+                        &mut sketch,
+                    );
+                }
+                (*id, sketch)
+            })
+            .collect::<Vec<_>>()
+    });
+    for (id, sketch) in parts.into_iter().flatten() {
+        let estimate = estimates[id].take().unwrap();
+        estimates[id] = Some(estimate.merged(&sketch));
+    }
+    drop(t);
+
+    let t = timers.start("resize");
+    sections.par_iter_mut().zip(&estimates).for_each(|(section, estimate)| {
+        if let Some(estimate) = estimate {
+            section.estimation = estimate.cardinality();
+            section.map = ConcurrentMap::with_capacity(section.estimation as usize * 3 / 2);
+        }
+    });
+    drop(t);
+
+    let t = timers.start("resolve_contents");
+    rayon::broadcast(|worker| {
+        let mut jobs = jobs[worker.index()].lock().unwrap();
+        for (id, members) in jobs.iter_mut() {
+            for member in members.iter_mut() {
+                member.merge_info.resolve_contents(member.data, &sections[*id], gc_sections);
+            }
+        }
+    });
+    drop(t);
+}
