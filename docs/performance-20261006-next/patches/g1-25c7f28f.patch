+/// GC repeatedly follows symbol origins while traversing relocations. Keep
+/// only the resolved target needed by this pass, rather than revisiting the
+/// larger symbol record and its owner/section lookup on every graph edge.
+/// References remain valid until marking and sweeping have completed.
+#[derive(Clone, Copy)]
+enum GcTarget<'a, E: Target> {
+    None,
+    Section(&'a InputSection<E>),
+    Fragment(&'a SectionFragment),
+    Dso(DsoId),
+    // Start/stop references can both name an ordinary section and retain a
+    // whole section-name group. Keep their existing path intact.
+    Special(SymbolId),
+}
+
+fn build_targets<'a, E: Target>(
+    ctx: &'a Context<E>,
+    map: &StartStopMap<'a, E>,
+) -> Vec<GcTarget<'a, E>> {
+    let _t = ctx.timer("build_gc_targets");
+    (0..ctx.symbols.len())
+        .into_par_iter()
+        .map(|index| {
+            let id = SymbolId(index as u32);
+            let sym = &ctx.symbols[id];
+            if let Some(FileId::Dso(dso)) = sym.file() {
+                return GcTarget::Dso(dso);
+            }
+            let origin = sym.origin();
+            if let OriginValue::Fragment(fragment) = origin {
+                return GcTarget::Fragment(ctx.fragment(fragment));
+            }
+            if !map.is_empty()
+                && start_stop_name(sym.name()).is_some_and(|name| map.contains_key(name))
+            {
+                return GcTarget::Special(id);
+            }
+            match origin {
+                OriginValue::InputSection(section) => GcTarget::Section(ctx.input_section(section)),
+                _ => GcTarget::None,
+            }
+        })
+        .collect()
+}
