+#[cfg(test)]
+mod compact_offset_tests {
+    use super::*;
+    use crate::arch::X86_64;
+
+    #[test]
+    fn compact_offsets_follow_layout_and_dwarf32_relayout() {
+        let mut section = MergedSection::<X86_64>::new(
+            BStr::new(b".debug_str"),
+            (SHF_MERGE | SHF_STRINGS) as u64,
+            SHT_PROGBITS,
+            1,
+        );
+        section.map = ConcurrentMap::with_capacity(100);
+        section.estimation = 4096;
+        section.hdr.shdr.sh_addralign.set(8);
+        let first = section.insert(b"first\0", 1, 0, true);
+        let aligned = section.insert(b"aligned\0", 2, 3, true);
+        let last = section.insert(b"last\0", 16383, 0, true);
+        assert_eq!(section.insert(b"aligned\0", 2, 2, true), aligned);
+        section.fragments = std::mem::take(&mut section.map).freeze();
+        section.resolved = true;
+        layout(&mut section);
+        assert!(section.compact_offsets.is_some());
+        let before = section.fragment_offset(last);
+        for id in [first, aligned, last] {
+            assert_eq!(section.fragment_offset(id), section.fragments.get(id).offset());
+        }
+        section.fragments.get(last).set_32bit();
+        layout(&mut section);
+        assert_ne!(section.fragment_offset(last), before);
+        for id in [first, aligned, last] {
+            assert_eq!(section.fragment_offset(id), section.fragments.get(id).offset());
+        }
+        section.hdr.shdr.sh_flags.set((SHF_MERGE | SHF_STRINGS | SHF_ALLOC) as u64);
+        layout(&mut section);
+        assert!(section.compact_offsets.is_none());
+        assert_eq!(section.fragment_offset(last), section.fragments.get(last).offset());
+    }
+}
