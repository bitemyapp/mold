+    /// Builds a compact side table preserving the map's bucket identities.
+    pub(crate) fn map_buckets<U: Send>(&self, map: impl Fn(Option<&T>) -> U + Send + Sync) -> Vec<U>
+    where
+        T: Send + Sync,
+    {
+        (0..self.0.nbuckets)
+            .into_par_iter()
+            .map(|i| map(self.0.is_occupied(i).then(|| self.0.value_at(i))))
+            .collect()
+    }
