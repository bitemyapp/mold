+/// Local unique-insertion counts for one table. A Rayon fold owns each
+/// instance; combining folds needs no shared counters or additional scan.
+#[derive(Clone)]
+pub(crate) struct ShardCounts {
+    counts: [usize; NUM_SHARDS],
+    shift: u32,
+}
+
+impl ShardCounts {
+    pub(crate) fn record(&mut self, id: EntryId, inserted: bool) {
+        if inserted {
+            self.counts[(id.raw() >> self.shift) as usize] += 1;
+        }
+    }
+
+    pub(crate) fn combine(mut self, other: Self) -> Self {
+        debug_assert_eq!(self.shift, other.shift);
+        for (left, right) in self.counts.iter_mut().zip(other.counts) {
+            *left += right;
+        }
+        self
+    }
+}
