@@ -0,0 +1,19 @@
+#!/usr/bin/env bash
+. $(dirname $0)/common.inc
+unset MOLD_DEBUG
+
+# Input comments may already contain the linker's own identification.
+# Synthetic insertion must count only its unique winner, plus the optional
+# command-line comment, after parallel input merging has joined.
+version=$(./mold --version)
+cat <<EOF2 | $CC -c -o $t/a.o -x assembler -
+.section .comment,"MS",%progbits,1
+.asciz "$version"
+.asciz "$version"
+EOF2
+
+./mold -shared -o $t/a.so $t/a.o --stats > $t/plain
+MOLD_DEBUG=1 ./mold -shared -o $t/b.so $t/a.o --stats > $t/debug
+grep -E '^\.comment estimation=[0-9]+ actual=1$' $t/plain
+grep -E '^\.comment estimation=[0-9]+ actual=2$' $t/debug
+readelf -p .comment $t/b.so | grep 'mold command line:'
